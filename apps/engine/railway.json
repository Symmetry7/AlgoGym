{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci && npm run build -w @algogym/engine",
    "watchPatterns": ["apps/engine/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm start -w @algogym/engine",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
