# Copy to .env.local. Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_ORIGIN=http://localhost:8080
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required only for Symm AI curriculum, lessons, code variants and tutoring.
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_KEY
# Optional model override; see server/symm-ai.ts for the default.
# GEMINI_MODEL=gemini-3.5-flash-lite
