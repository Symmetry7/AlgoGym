# Copy to .env.local. Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are also
# supported aliases. Use the same project if both naming conventions are set.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_ORIGIN=http://localhost:8080
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Only the Resend account owner's address may receive development-domain mail.
RESEND_TEST_RECIPIENT=

# Required only for Symm AI curriculum, lessons, code variants and tutoring.
GEMINI_API_KEY=YOUR_SERVER_ONLY_GEMINI_KEY
# Optional model override; see server/symm-ai.ts for the default.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Enable only after applying and verifying the AI credit migration.
SYMM_AI_CREDITS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_WEBHOOK_SECRET=
